// Zinzino Connect AI — data model.
// SQLite for MVP; every type here is Postgres-compatible, so migration is a
// datasource swap. JSON payloads are stored as String (see src/lib/json.ts).

generator client {
  provider = "prisma-client-js"
  // "rhel-openssl-3.0.x" is the runtime on Vercel/AWS Lambda.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  address         String?
  birthday        DateTime?
  photoUrl        String?
  status          String    @default("LEAD") // LEAD | CUSTOMER | INACTIVE
  interests       String    @default("[]") // JSON string[]
  commPreference  String? // SMS | EMAIL | WHATSAPP
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchases    Purchase[]
  balanceTests BalanceTest[]
  messages     Message[]
  reminders    Reminder[]
  timeline     TimelineEvent[]
  reviewTasks  ReviewTask[]

  @@index([status])
  @@index([lastContactedAt])
  @@index([birthday])
}

model Product {
  id        String     @id @default(cuid())
  name      String     @unique
  category  String
  purchases Purchase[]
}

model Purchase {
  id          String   @id @default(cuid())
  contactId   String
  productId   String
  purchasedAt DateTime @default(now())
  notes       String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([contactId])
}

model BalanceTest {
  id        String   @id @default(cuid())
  contactId String
  testDate  DateTime
  notes     String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

// Append-only history feed rendered on the contact profile.
model TimelineEvent {
  id          String   @id @default(cuid())
  contactId   String
  type        String // IMPORTED | NOTE | MESSAGE_SENT | PURCHASE | BALANCE_TEST | REMINDER_CREATED | AI_SUGGESTION | STATUS_CHANGE
  title       String
  description String?
  occurredAt  DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, occurredAt])
}

// State machine: DRAFT -> PENDING_APPROVAL -> APPROVED -> SENT, or REJECTED.
// The ONLY path to SENT is a human approval (enforced in messageService).
model Message {
  id          String    @id @default(cuid())
  contactId   String
  channel     String // SMS | EMAIL | WHATSAPP
  direction   String    @default("OUTBOUND") // OUTBOUND | INBOUND
  subject     String?
  body        String
  status      String    @default("PENDING_APPROVAL") // DRAFT | PENDING_APPROVAL | APPROVED | SENT | REJECTED
  aiGenerated Boolean   @default(false)
  source      String? // automation type or "copilot" / "manual" — provenance
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([status])
}

model Reminder {
  id            String    @id @default(cuid())
  contactId     String
  type          String // BIRTHDAY | FOLLOW_UP | BALANCE_TEST | REORDER | CUSTOM
  title         String
  dueDate       DateTime
  status        String    @default("PENDING") // PENDING | DONE | DISMISSED
  autoGenerated Boolean   @default(false)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([status, dueDate])
}

// One row per automation rule type; the engine reads enabled rows.
model Automation {
  id          String   @id @default(cuid())
  type        String   @unique // BIRTHDAY | FOLLOW_UP_30 | FOLLOW_UP_60 | FOLLOW_UP_90 | BALANCE_TEST_6M | REORDER | INACTIVE | LEAD_NURTURE
  name        String
  description String
  enabled     Boolean  @default(true)
  config      String   @default("{}") // JSON, e.g. {"days": 30}
  lastRunAt   DateTime?
}

// Staging area for AI contact import. Contacts are only created on approval.
model ImportJob {
  id            String    @id @default(cuid())
  source        String // SCAN | PDF | PHOTO | SCREENSHOT | EMAIL | TEXT
  fileName      String?
  rawText       String? // pasted/forwarded text input, if any
  extractedJson String    @default("[]") // JSON: ExtractedContact[]
  status        String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED
  error         String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
}

// App-level key-value settings (partner name, signature, …).
model Setting {
  key   String @id
  value String
}

// Human-review queue, e.g. when a customer asks a medical question.
model ReviewTask {
  id         String    @id @default(cuid())
  contactId  String?
  reason     String // MEDICAL_QUESTION | OTHER
  details    String
  status     String    @default("OPEN") // OPEN | RESOLVED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([status])
}
