# Database — Postgres required. On Vercel, create a Neon database via
# Storage → Create Database → Neon and it auto-injects DATABASE_URL.
DATABASE_URL="postgresql://user:pass@host:5432/zinzino"

# Clerk authentication — sign up at clerk.com, create an application, then
# copy these from API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# AI provider. Leave ANTHROPIC_API_KEY unset to run with the built-in mock
# provider (fully functional demo mode, deterministic outputs).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# Messaging (Phase 2 — Twilio/email providers read these when implemented)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
EMAIL_FROM=""
