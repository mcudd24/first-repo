# Database — SQLite for MVP. For Postgres, change provider in prisma/schema.prisma
# and set e.g. DATABASE_URL="postgresql://user:pass@host:5432/zinzino"
DATABASE_URL="file:./dev.db"

# AI provider. Leave ANTHROPIC_API_KEY unset to run with the built-in mock
# provider (fully functional demo mode, deterministic outputs).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# Messaging (Phase 2 — Twilio/email providers read these when implemented)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
EMAIL_FROM=""
